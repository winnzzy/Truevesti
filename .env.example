# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/truevesti"

# API server
PORT=4000
NODE_ENV=development
WEB_ORIGIN="http://localhost:3000"
API_ORIGIN="http://localhost:4000"

# JWT (use long random secrets in production)
JWT_ACCESS_SECRET="change-me-access-min-16-chars"
JWT_REFRESH_SECRET="change-me-refresh-min-16-chars"

# Email (resend | sendgrid | smtp | console)
EMAIL_PROVIDER="resend"
EMAIL_FROM="Truevesti <onboarding@yourdomain.com>"
RESEND_API_KEY=""
SENDGRID_API_KEY=""
SMTP_HOST=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASS=""

# OTP
OTP_EXPIRY_MINUTES=10
OTP_RATE_LIMIT_MAX=5
OTP_RATE_LIMIT_WINDOW_MS=900000

# Admin seed (optional)
ADMIN_EMAIL="admin@truevesti.local"
ADMIN_PASSWORD="ChangeMe-Admin-Password1"

# Web — Vercel (required in production; use your Render service URL, no trailing slash)
NEXT_PUBLIC_API_URL="https://your-truevesti-api.onrender.com"

# API — Render (allow your Vercel frontend)
# WEB_ORIGIN="https://truevesti-web.vercel.app"

# Crypto / compliance (existing platform settings)
CRYPTO_PROVIDER="mock"
CRYPTO_PROVIDER_API_KEY=""
MASTER_WALLET_ADDRESSES='{"USDC":"0x...","USDT":"0x...","BTC":"bc1...","ETH":"0x...","SOL":"...","BNB":"0x..."}'
MASTER_WALLET_MNEMONIC=""
CHAIN_WEBHOOK_SECRET=""
ENCRYPTION_KEY=""
CAPTCHA_SECRET=""

# OAuth (optional, not used by MVP auth flow)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
APPLE_CLIENT_ID=""
APPLE_CLIENT_SECRET=""
MICROSOFT_CLIENT_ID=""
MICROSOFT_CLIENT_SECRET=""
