# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/truevesti"
# Production Neon: use the pooled connection URL for runtime DATABASE_URL.
# Prisma CLI/migrations require a direct Neon connection URL.
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/truevesti"

# API server
PORT=4000
NODE_ENV=development
WEB_ORIGIN="http://localhost:3000"
API_ORIGIN="http://localhost:4000"

# CORS — comma-separated origins (all of these are read; WEB_ORIGIN is also included)
# CORS_ORIGIN=""
# CORS_ORIGINS=""
# ALLOWED_ORIGINS=""
# FRONTEND_URL=""

# JWT (use long random secrets in production)
JWT_ACCESS_SECRET="change-me-access-min-16-chars"
JWT_REFRESH_SECRET="change-me-refresh-min-16-chars"

# Email (resend | sendgrid | smtp | console)
EMAIL_PROVIDER="resend"
# REQUIRED in production: use an address on your verified Resend domain, e.g. noreply@yourdomain.com
# In development you can omit this to fall back to onboarding@resend.dev (Resend's test sender)
EMAIL_FROM="noreply@yourdomain.com"
RESEND_API_KEY=""
SENDGRID_API_KEY=""
SMTP_HOST=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASS=""

# OTP
OTP_EXPIRY_MINUTES=10
OTP_RATE_LIMIT_MAX=5
OTP_RATE_LIMIT_WINDOW_MS=900000

# Admin auto-create (runs on server startup — no Render Shell needed)
# Set ADMIN_AUTO_CREATE=true to auto-create/promote admin on every deploy
ADMIN_AUTO_CREATE="true"
ADMIN_EMAIL="admin@truevesti.local"
ADMIN_PASSWORD="ChangeMe-Admin-Password1"
ADMIN_NAME="Admin"
# Set to true only when you want to force-reset the admin password on next deploy
ADMIN_RESET_PASSWORD="false"
ADMIN_PURGE_SECRET="pick-a-long-random-secret-only-you-know"

# Web — Vercel (required in production; use your Render service URL, no trailing slash)
NEXT_PUBLIC_API_URL="https://truevesti-api.onrender.com"

# API — Render (allow your Vercel frontend; comma-separated for multiple origins)
# All *.vercel.app origins are also automatically allowed by CORS middleware
# WEB_ORIGIN="https://truevesti-web.vercel.app"

# Crypto / Wallet provider
# Options: trust-wallet-core | static-wallet | mnemonic-wallet | mock
# - mock: ONLY allowed when NODE_ENV=development, returns fake addresses
# - trust-wallet-core: Real blockchain addresses via Trust Wallet Core WASM
# - static-wallet: JSON map of pre-configured addresses
# - mnemonic-wallet: BIP44 derivation (address placeholders)
CRYPTO_PROVIDER="trust-wallet-core"
CRYPTO_PROVIDER_API_KEY=""
# Required for CRYPTO_PROVIDER=static-wallet: JSON map of network → address
MASTER_WALLET_ADDRESSES='{"BTC":"bc1q...","ETH":"0x...","TRX":"T..."}'
# Required for trust-wallet-core / mnemonic-wallet: valid BIP39 mnemonic (12 or 24 words)
MASTER_WALLET_MNEMONIC=""
# Derivation account index (default: 0)
WALLET_DERIVATION_ACCOUNT=0
CHAIN_WEBHOOK_SECRET=""
ENCRYPTION_KEY=""
CAPTCHA_SECRET=""

# OAuth (optional, not used by the current auth flow)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
APPLE_CLIENT_ID=""
APPLE_CLIENT_SECRET=""
MICROSOFT_CLIENT_ID=""
MICROSOFT_CLIENT_SECRET=""
