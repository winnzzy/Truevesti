NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://user:password@localhost:5432/truevesti?schema=public
WEB_ORIGIN=http://localhost:3000
JWT_ACCESS_SECRET=change-me-to-a-long-random-string-at-least-16-chars
JWT_REFRESH_SECRET=change-me-to-another-long-random-string-at-least-16

# Email provider (resend, sendgrid, smtp, console)
EMAIL_PROVIDER=console
EMAIL_FROM=noreply@example.com
# RESEND_API_KEY=
# SENDGRID_API_KEY=
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=

OTP_EXPIRY_MINUTES=10
OTP_RATE_LIMIT_MAX=5
OTP_RATE_LIMIT_WINDOW_MS=900000

# OAuth providers
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# MICROSOFT_CLIENT_ID=
# MICROSOFT_CLIENT_SECRET=
# APPLE_CLIENT_ID=
# APPLE_CLIENT_SECRET=

# Webhook secret for Chain Watcher requests
CHAIN_WEBHOOK_SECRET=

# Crypto / Wallet provider
# Options: trust-wallet-core | static-wallet | mnemonic-wallet | mock
# - mock: ONLY allowed when NODE_ENV=development, returns fake addresses
# - trust-wallet-core: Real blockchain addresses via Trust Wallet Core WASM
# - static-wallet: JSON map of pre-configured addresses
# - mnemonic-wallet: BIP44 derivation (address placeholders)
CRYPTO_PROVIDER=trust-wallet-core

# Required when CRYPTO_PROVIDER=trust-wallet-core or mnemonic-wallet
# Must be a valid BIP39 mnemonic (12 or 24 words)
MASTER_WALLET_MNEMONIC=

# Derivation account index for trust-wallet-core / mnemonic-wallet (default: 0)
WALLET_DERIVATION_ACCOUNT=0

# Required for CRYPTO_PROVIDER=static-wallet: JSON map of network → address
# MASTER_WALLET_ADDRESSES={"BTC":"bc1q...","ETH":"0x...","TRX":"T..."}

# Optional API key for remote wallet providers
# CRYPTO_PROVIDER_API_KEY=

# Encryption key for sensitive data at rest (optional)
# ENCRYPTION_KEY=

# Admin-only purge secret (optional)
# ADMIN_PURGE_SECRET=

# CAPTCHA verification secret (optional — add a real verifier before production)
# CAPTCHA_SECRET=
