DATABASE_URL="postgresql://postgres:postgres@localhost:5432/truevesti"
PORT=4000
NODE_ENV=development
# Render: allow your Vercel app origin for CORS
WEB_ORIGIN="https://truevesti-web.vercel.app"

JWT_ACCESS_SECRET="change-me-access-min-16-chars"
JWT_REFRESH_SECRET="change-me-refresh-min-16-chars"

EMAIL_PROVIDER="resend"
# Resend test sender (no domain required): onboarding@resend.dev
# Free tier: OTP can only be sent TO the email on your Resend account until you verify a domain.
EMAIL_FROM="onboarding@resend.dev"
RESEND_API_KEY=""
SENDGRID_API_KEY=""
SMTP_HOST=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASS=""

OTP_EXPIRY_MINUTES=10
OTP_RATE_LIMIT_MAX=5
OTP_RATE_LIMIT_WINDOW_MS=900000

ADMIN_EMAIL="admin@truevesti.local"
ADMIN_PASSWORD="ChangeMe-Admin-Password1"

# One-time user cleanup from PowerShell (POST /admin/purge-user + x-purge-secret header)
ADMIN_PURGE_SECRET="pick-a-long-random-secret-only-you-know"

CRYPTO_PROVIDER="mock"
CRYPTO_PROVIDER_API_KEY=""
MASTER_WALLET_ADDRESSES='{"USDC":"0x...","USDT":"0x...","BTC":"bc1...","ETH":"0x...","SOL":"...","BNB":"0x..."}'
MASTER_WALLET_MNEMONIC=""
CHAIN_WEBHOOK_SECRET=""
CAPTCHA_SECRET=""
ENCRYPTION_KEY=""
