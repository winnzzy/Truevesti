{
  "name": "truevesti",
  "private": true,
  "workspaces": [
    "apps/web",
    "apps/api"
  ],
  "scripts": {
    "dev:web": "npm run dev --workspace apps/web",
    "dev:api": "npm run dev --workspace apps/api",
    "build": "npm run build --workspace apps/api && npm run build --workspace apps/web",
    "lint": "npm run lint --workspace apps/web && npm run lint --workspace apps/api",
    "typecheck": "npm run typecheck --workspace apps/web && npm run typecheck --workspace apps/api",
    "prisma:migrate": "npm run prisma:migrate --workspace apps/api",
    "prisma:studio": "npm run prisma:studio --workspace apps/api",
    "prisma:seed": "npm run prisma:seed --workspace apps/api"
  },
  "engines": {
    "node": ">=20"
  },
  "overrides": {
    "next@16.2.6": {
      "postcss": "^8.5.14"
    }
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@types/bcrypt": "latest",
    "@types/cookie-parser": "latest",
    "@types/cors": "latest",
    "@types/express": "latest",
    "@types/jsonwebtoken": "latest",
    "@types/node": "latest",
    "@types/nodemailer": "latest",
    "eslint": "^9.39.4"
  }
}
